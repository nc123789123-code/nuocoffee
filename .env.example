# Copy these into Vercel → Project → Settings → Environment Variables.
# Do NOT commit real values — this file is only a template.

# The Google Apps Script web-app URL that appends signups to your Sheet.
# (Deploy sheets-endpoint.gs as a Web app and paste its URL here.)
SHEETS_WEBHOOK_URL=

# Optional shared secret. If set, it must match the WAITLIST_TOKEN
# script property in your Apps Script project. Leave blank to skip.
SHEETS_TOKEN=
